{
  "name": "accesspath-ci",
  "version": "0.1.0",
  "private": true,
  "description": "Replay critical web flows and catch accessibility regressions in CI.",
  "type": "commonjs",
  "bin": {
    "accesspath": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts",
    "demo": "node demo/server.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "playwright": "^1.54.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
